# SignalPack stores the OpenRouter key in browser localStorage via Settings.
# Public repo default: users paste their own key in Settings.
# Hosted demo builds may inject VITE_SIGNALPACK_DEMO_OPENROUTER_KEY at deploy time.
# Note: any Vite client env var is visible in the shipped frontend bundle.
# Hosted default model: google/gemma-4-31b-it:free@preset/signalpack
# Local Gemma uses a user-owned Ollama runtime configured in app Settings.

VITE_SIGNALPACK_DEMO_OPENROUTER_KEY=

# Use this when deploying under https://pixek.xyz/signalpack instead of domain root.
VITE_BASE_PATH=/signalpack/

GOOGLE_MAPS_PLATFORM_KEY=

# Optional Firebase sync/auth config.
# Firebase web API keys are client identifiers, but keep real project config out of public commits.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://pixek.xyz/signalpack"

# SignalPack stores the OpenRouter key in browser localStorage via Settings.
# Do not put demo keys in this public file or in a Vite-exposed env var.
# Hosted default model: google/gemma-4-26b-a4b-it
# Local Gemma runtimes are user-owned extensions and are not configured here.

GOOGLE_MAPS_PLATFORM_KEY=

# Optional Firebase sync/auth config.
# Firebase web API keys are client identifiers, but keep real project config out of public commits.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

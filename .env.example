# SignalPack stores the OpenRouter key in browser localStorage via Settings.
# Do not put demo keys in this public file or in a Vite-exposed env var.
# Hosted default model: google/gemma-4-26b-a4b-it
# Local Gemma runtimes are user-owned extensions and are not configured here.

GOOGLE_MAPS_PLATFORM_KEY=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
